{
  // Existing Cloudflare Worker and D1 database already created in the dashboard.
  "name": "wandering-cell-cf47minevora-profile-api",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "vars": {
    "MS_API_AUDIENCE": "72a4154b-5254-4c4b-958f-0a5181a0ad93"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "minevora-profiles",
      "database_id": "f71869b8-7e43-4ca1-9324-0c5922b86cc0",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": false }
}
